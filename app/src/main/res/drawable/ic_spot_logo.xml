<?xml version="1.0" encoding="utf-8"?>
<!--
    Spot logo: a map pin with a check mark (checking in), a ring where it lands and a small sparkle.
    Colours come from @color/spot_logo_*, which have light and dark versions (values / values-night),
    so the logo matches our theme in both modes.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="72dp"
    android:height="72dp"
    android:viewportWidth="72"
    android:viewportHeight="72">
    <group
        android:translateX="-18"
        android:translateY="-16">
        <!-- Ring under the pin -->
        <path
            android:pathData="M39,82 a15,4.5 0 1,0 30,0 a15,4.5 0 1,0 -30,0"
            android:strokeColor="@color/spot_logo_accent"
            android:strokeAlpha="0.9"
            android:strokeWidth="3" />
        <!-- Pin -->
        <path
            android:fillColor="@color/spot_logo_pin"
            android:pathData="M54,83 C48,75 34,62 34,46 A20,20 0 1,1 74,46 C74,62 60,75 54,83 Z" />
        <!-- Inner circle -->
        <path
            android:fillColor="@color/spot_logo_inner"
            android:pathData="M43,46 a11,11 0 1,0 22,0 a11,11 0 1,0 -22,0" />
        <!-- Check mark -->
        <path
            android:pathData="M48.5,46.5 L52.5,50.5 L60,42.5"
            android:strokeColor="@color/spot_logo_pin"
            android:strokeLineCap="round"
            android:strokeLineJoin="round"
            android:strokeWidth="3.6" />
        <!-- Sparkle -->
        <path
            android:fillColor="@color/spot_logo_accent"
            android:pathData="M78,17 Q79,23 85,24 Q79,25 78,31 Q77,25 71,24 Q77,23 78,17 Z" />
    </group>
</vector>
